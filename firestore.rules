rules_version = '2';

// Security rules of the Firestore database behind La Poule Traverse
// (Firebase project la-poule-traverse). Published from the Firebase console,
// or with `firebase deploy --only firestore:rules` (see firebase.json).
//
//   users/{uid}          a player's save. Only they can read or write it;
//                        the game's admin can also read every save (stats screen).
//   pseudos/{lowercase}  unique public names. Anyone can read; claiming one
//                        and freeing your own are the only writes.
//   leaderboard/{uid}    public all-time line of a player who chose a pseudo,
//                        also their public profile (what their hen wears).
//   seasons/{day}/entries/{uid}   public line of that player in one day's league.
//   daily/{day}/entries/{uid}     public line of that player on a day's challenge.
//   duels/{id}           a duel between two players, seen and changed by them only.
//   teams/{id}           a poulailler (team). Public; members join and leave themselves.
//   feed/{id}            the public activity feed: big moments, posted by their player.
//   suggestions/{id}     the idea box: public ideas, votes, and the admin's answers.
//
// Saves are computed in the player's browser, so a determined player can
// still fake their own numbers; these rules keep the data well formed, private
// where it should be, and every player in charge of their own documents only.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The admin sees every save, for the stats screen (poule/#admin). Read only.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'theolangevin3@gmail.com';
    }

    function validPseudo(pseudo) {
      return pseudo is string && pseudo.matches('^[A-Za-z0-9_-]{3,16}$');
    }

    function validTitle(title) {
      return title == null || (title is string && title.size() <= 40);
    }

    // What a hen wears, shown on public profiles: slot -> item id.
    function validLook(look) {
      return look is map
        && look.keys().hasOnly(['hat', 'neck', 'plumage', 'trail', 'road', 'party', 'title', 'skin'])
        && look.get('hat', '') is string && look.get('neck', '') is string
        && look.get('plumage', '') is string && look.get('trail', '') is string
        && look.get('road', '') is string && look.get('party', '') is string
        && look.get('title', '') is string && look.get('skin', '') is string;
    }

    // The pseudo is this player's once the write is applied.
    function ownsPseudo(pseudo) {
      return validPseudo(pseudo)
        && getAfter(/databases/$(database)/documents/pseudos/$(pseudo.lower())).data.uid == request.auth.uid;
    }

    function savedXp(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.save.xp;
    }

    function savedLp(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.save.league.lp;
    }

    // Only the current save format may be written: an outdated game (v1 to v3)
    // cannot overwrite a save any more. Saison 1 = epoch 1.
    function validSave(save) {
      return save is map
        && save.v == 4
        && save.epoch is int && save.epoch >= 1
        && save.league is map && save.league.lp is int && save.league.lp >= 0
        && save.balanceCents is int && save.balanceCents >= 0
        && save.xp is int && save.xp >= 0
        && save.feathers is int && save.feathers >= 0
        && save.upgrades is list && save.upgrades.size() <= 50
        && save.achievements is list && save.achievements.size() <= 100
        && save.rounds is list && save.rounds.size() <= 1000
        && (!('claims' in save) || (save.claims is list && save.claims.size() <= 600));
    }

    // Light anti-cheat: what one write may add to a save. Generous for a real
    // player (the biggest payout, rewards, many rounds between two syncs),
    // but a faked save cannot jump to absurd numbers in one go.
    function plausibleGain(before, after) {
      let elapsedMs = request.time.toMillis() - before.updatedAt.toMillis();
      return after.save.balanceCents <= before.save.balanceCents + 1010000000
        && after.save.xp <= before.save.xp + 3000 + elapsedMs / 1000 * 300
        && after.save.league.lp <= before.save.league.lp + 2000;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['save', 'rev', 'createdAt', 'updatedAt'])
        && validSave(request.resource.data.save)
        && request.resource.data.save.balanceCents <= 2000000000
        && request.resource.data.save.league.lp <= 2000
        && request.resource.data.rev == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Each write is the next revision, so two devices cannot silently
      // overwrite each other.
      // `pseudo` is a leftover of the game server (Nov. 2026) on some
      // accounts: kept as it is, never changed.
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['save', 'rev', 'createdAt', 'updatedAt', 'pseudo'])
        && request.resource.data.get('pseudo', null) == resource.data.get('pseudo', null)
        && validSave(request.resource.data.save)
        && plausibleGain(resource.data, request.resource.data)
        && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /pseudos/{name} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'pseudo'])
        && request.resource.data.uid == request.auth.uid
        && validPseudo(request.resource.data.pseudo)
        && request.resource.data.pseudo.lower() == name;

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // The coop's public numbers cannot exceed the player's own saved coop.
    function validCoopLine(uid, data) {
      let eggs = data.get('coopEggs', 0);
      let week = data.get('coopWeek', { 'week': '', 'eggs': 0 });
      return eggs is number && eggs >= 0
        && week is map && week.keys().hasOnly(['week', 'eggs'])
        && week.week is string && week.week.size() <= 10
        && week.eggs is number && week.eggs >= 0 && week.eggs <= eggs
        && (eggs == 0 || eggs <= get(/databases/$(database)/documents/users/$(uid)).data.save.coop.lifetime);
    }

    match /leaderboard/{uid} {
      allow read: if true;

      // The experience and tokens shown cannot exceed the player's own save.
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['pseudo', 'look', 'title', 'level', 'xp', 'tokens', 'lp', 'division', 'bestMultiplier', 'bestLanes', 'team', 'coopEggs', 'coopWeek', 'updatedAt'])
        && (request.resource.data.get('team', null) == null
          || request.auth.uid in get(/databases/$(database)/documents/teams/$(request.resource.data.team)).data.members)
        && request.resource.data.lp is int && request.resource.data.lp >= 0
        && request.resource.data.lp <= savedLp(uid)
        && request.resource.data.division is string && request.resource.data.division.size() <= 20
        && ownsPseudo(request.resource.data.pseudo)
        && validLook(request.resource.data.get('look', {}))
        && validTitle(request.resource.data.get('title', null))
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 50
        && request.resource.data.xp is int && request.resource.data.xp >= 0
        && request.resource.data.xp <= savedXp(uid)
        && request.resource.data.get('tokens', 0) is int && request.resource.data.get('tokens', 0) >= 0
        && request.resource.data.get('tokens', 0) <= get(/databases/$(database)/documents/users/$(uid)).data.save.balanceCents
        && request.resource.data.bestMultiplier is number
        && request.resource.data.bestMultiplier >= 0 && request.resource.data.bestMultiplier <= 5000
        && request.resource.data.bestLanes is int
        && request.resource.data.bestLanes >= 0 && request.resource.data.bestLanes <= 24
        && validCoopLine(uid, request.resource.data)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(uid);
    }

    match /seasons/{season}/entries/{uid} {
      allow read: if true;

      // A day's score is experience earned that day: never more than the save's total.
      allow create, update: if isOwner(uid)
        && season.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['pseudo', 'title', 'level', 'score', 'bestMultiplier', 'league', 'updatedAt'])
        && ownsPseudo(request.resource.data.pseudo)
        && validTitle(request.resource.data.get('title', null))
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 50
        && request.resource.data.score is int && request.resource.data.score >= 0
        && request.resource.data.score <= savedXp(uid)
        && request.resource.data.score <= 200000
        && request.resource.data.bestMultiplier is number
        && request.resource.data.bestMultiplier >= 0 && request.resource.data.bestMultiplier <= 5000
        && (request.resource.data.league == null || (request.resource.data.league is string && request.resource.data.league.size() <= 20))
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(uid);
    }

    match /daily/{day}/entries/{uid} {
      allow read: if true;

      // The day's challenge: three tries at most (five in the weekend tournament), the best multiplier cashed out.
      allow create, update: if isOwner(uid)
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['pseudo', 'title', 'best', 'tries', 'updatedAt'])
        && ownsPseudo(request.resource.data.pseudo)
        && validTitle(request.resource.data.get('title', null))
        && request.resource.data.best is number
        && request.resource.data.best >= 0 && request.resource.data.best <= 5000
        && request.resource.data.tries is int
        && request.resource.data.tries >= 1 && request.resource.data.tries <= 5
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(uid);
    }

    function inDuel(data) {
      return signedIn() && (data.from.uid == request.auth.uid || data.to.uid == request.auth.uid);
    }

    match /duels/{id} {
      allow read: if inDuel(resource.data);

      // The challenger sends it, with one of the allowed stakes and no score yet.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'mode', 'stake', 'status', 'createdAt', 'expiresAt', 'scores'])
        && request.resource.data.from.uid == request.auth.uid
        && request.resource.data.to.uid != request.auth.uid
        && ownsPseudo(request.resource.data.from.pseudo)
        && request.resource.data.mode in ['easy', 'medium', 'hard', 'hardcore', 'night', 'mystery']
        && request.resource.data.stake in [2500, 10000, 50000]
        && request.resource.data.status == 'open'
        && request.resource.data.scores == {};

      // Each player changes only their own score (3 tries at most); only the
      // challenged player answers an open duel.
      allow update: if inDuel(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'scores', 'expiresAt'])
        && request.resource.data.scores.diff(resource.data.scores).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.scores)
          || (request.resource.data.scores[request.auth.uid].tries is int
            && request.resource.data.scores[request.auth.uid].tries <= 3
            && request.resource.data.scores[request.auth.uid].best is number
            && request.resource.data.scores[request.auth.uid].best <= 5000))
        && (request.resource.data.status == resource.data.status
          || (resource.data.status == 'open'
            && resource.data.to.uid == request.auth.uid
            && request.resource.data.status in ['accepted', 'declined']));
    }

    match /teams/{id} {
      allow read: if true;

      // The founder creates it alone in it.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'pseudos', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.pseudos.keys().hasOnly([request.auth.uid])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 20;

      // A player only adds or removes themself; 10 members at most.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'pseudos'])
        && request.resource.data.members.size() <= 10
        && request.resource.data.pseudos.diff(resource.data.pseudos).affectedKeys().hasOnly([request.auth.uid])
        && (request.resource.data.members.toSet().difference(resource.data.members.toSet()) == [request.auth.uid].toSet()
          || resource.data.members.toSet().difference(request.resource.data.members.toSet()) == [request.auth.uid].toSet());

      // The last member leaving deletes it.
      allow delete: if signedIn() && resource.data.members == [request.auth.uid];
    }

    // The idea box: public; a player with a pseudo posts up to 3 ideas a day
    // (the id holds the day and a number), votes once per idea; the admin answers.
    match /suggestions/{id} {
      allow read: if true;

      allow create: if signedIn()
        && id.matches(request.auth.uid + '_[0-9]{8}_[1-3]')
        && request.resource.data.keys().hasOnly(['uid', 'pseudo', 'text', 'createdAt', 'votes', 'status', 'reply'])
        && request.resource.data.uid == request.auth.uid
        && ownsPseudo(request.resource.data.pseudo)
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5 && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.votes == []
        && request.resource.data.status == 'new'
        && request.resource.data.reply == null;

      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply'])
          && request.resource.data.status in ['new', 'planned', 'done', 'declined']
          && (request.resource.data.reply == null
            || (request.resource.data.reply is string && request.resource.data.reply.size() <= 300)))
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && !(request.auth.uid in resource.data.votes)
          && request.resource.data.votes.size() == resource.data.votes.size() + 1
          && request.resource.data.votes.hasAll(resource.data.votes)
          && request.auth.uid in request.resource.data.votes
          && request.resource.data.votes.size() <= 5000);

      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /feed/{id} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'pseudo', 'kind', 'mult', 'mode', 'lanes', 'other', 'at'])
        && request.resource.data.uid == request.auth.uid
        && ownsPseudo(request.resource.data.pseudo)
        && request.resource.data.kind in ['cash', 'finish', 'duel', 'promotion']
        && request.resource.data.mult is number && request.resource.data.mult >= 0 && request.resource.data.mult <= 5000
        && request.resource.data.lanes is int && request.resource.data.lanes >= 0 && request.resource.data.lanes <= 24
        && (request.resource.data.other == null || (request.resource.data.other is string && request.resource.data.other.size() <= 20))
        && request.resource.data.at is int;

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
